# emulate the utility of uniq -c
# assumes tidyverse is loaded
uniqdashc <- function(x,y) {
  # x is a dataframe; y is a column in that dataframe,
  # e.g., uniqdashc(Carseats,Education)
  # or say uniqdashc(Carseats,Education) |> arrange(Education)
  # to sort ascending by Education
  # Note:
  # this construct is superseded by, say:
  # Carseats |> count(Education)
  # or:
  # Carseats |> count(Education) |> arrange(n) # to sort ascending numbers
  # or:
  # Carseats |> count(Education) |> arrange(desc(n)) # to sort descending by count
  y <- enquo(y)
  x |>
    dplyr::select(!!y) |>
    group_by(!!y) |>
    dplyr::mutate(count=n()) |>
    unique() |>
    arrange(desc(count))
}
stemr <- function(data,z=1) {
  out <- capture.output(stem(data,scale=z))
  out <- c(out[1:3],rev(out[4:length(out)]))
  cat(out,sep="\n")
}
