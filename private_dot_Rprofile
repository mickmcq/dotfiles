# Load secrets from ~/.secrets, the single source of truth (age-encrypted in
# the dotfiles repo, sourced by ~/.bash_profile for shells). Parsing it here as
# well is what makes the keys reach GUI sessions: RStudio.app and R.app launch
# without the login shell's environment, which is why these keys were once
# duplicated into ~/.Renviron. Anything already set in the environment wins, so
# a shell export still overrides the file.
# Only the base package is loaded when .Rprofile runs -- base functions only.
local({
  f <- path.expand("~/.secrets")
  if (!file.exists(f)) return(invisible(NULL))
  kv <- grep("^\\s*export\\s+[A-Za-z_][A-Za-z0-9_]*=",
             readLines(f, warn = FALSE), value = TRUE)
  if (!length(kv)) return(invisible(NULL))
  kv   <- sub("^\\s*export\\s+", "", kv)
  keys <- sub("=.*$", "", kv)
  vals <- sub("^[^=]*=", "", kv)
  vals <- sub('^"(.*)"$', "\\1", vals)   # strip one layer of quoting
  vals <- sub("^'(.*)'$", "\\1", vals)
  new  <- !nzchar(Sys.getenv(keys))
  if (any(new)) {
    args <- as.list(vals[new])
    names(args) <- keys[new]
    do.call(Sys.setenv, args)
  }
})

