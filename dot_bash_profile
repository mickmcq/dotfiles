# ncolumns returns a numbered list of column headings
# usage: ncolumns filename <column delimiter>
# e.g.,
#      ncolumns db.txt "	"
# gives a numbered list of headings in db.txt. Note that
# the delimiter, a tab, is quoted by saying ctrl-V<tab>.
ncolumns () {
   head -n 1 "$1" | tr "$2" "\n" | nl
}
