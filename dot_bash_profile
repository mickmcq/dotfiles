ss() { # use this like   ss light single refs bla
			 # or              ss dark double norefs bla
			 # or              ss exec single norefs bla
  if [ $3 == "refs" ]; then
		pandoc -t beamer \
			--filter pandoc-include \
			--bibliography $4.bib   \
			--template pandocSlides \
			--slide-level=2 \
			$4.md \
			-o $4.tex;
	else
		pandoc -t beamer \
			--filter pandoc-include \
			--template pandocSlides \
			--slide-level=2 \
			$4.md \
			-o $4.tex;
	fi
	if [ $1 == "light" ] && [ $2 == "single" ]; then
	  xelatex -jobname $4 '\input{preamble-slides.tex}';
	elif [ $1 == "dark" ] && [ $2 == "single" ]; then
	  xelatex -jobname $4 '\input{preamble-darkslides.tex}';
	elif [ $1 == "exec" ] && [ $2 == "single" ]; then
	  xelatex -jobname $4 '\input{preamble-execstyle.tex}';
	elif [ $1 == "light" ] && [ $2 == "double" ]; then
	  lualatex -jobname $4 '\input{preamble-doubleslides.tex}';
	elif [ $1 == "dark" ] && [ $2 == "double" ]; then
	  lualatex -jobname $4 '\input{preamble-doubledarkslides.tex}';
	else
		echo "Unsupported combination!";
	fi
}
