# say, e.g., filesizes "*.txt" to see txt files with sizes
filesizes () {
  find . -name "$1" -print0 2>/dev/null \
  | xargs -0 /usr/bin/stat -f "%5z%t%Sa%t%N" -t "%Y%m%d%H%M%S";
} 
# say, e.g., filetimes "*.txt" to see txt files with times
filetimes () {
  find . -type f -name "$1" -print0 2>/dev/null \
  | xargs -0 /usr/bin/stat -f "%Sm%t%9z%t%N" -t "%Y%m%d%H%M%S" \
  | perl -pe 's/\t\.\//\t/';
}
# say, e.g., filepatterns "*.tex" "biblatex" to see
# lines in .tex files including the string biblatex
filepatterns () {
  find . -name "$1" -print0 2>/dev/null \
  | xargs -0 grep $2;
}
